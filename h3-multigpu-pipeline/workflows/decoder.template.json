{
  "load": {
    "class_type": "LoadH3Latent",
    "inputs": {"latent": "LATENT_FILENAME_REQUIRED"}
  },
  "video_vae": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "H3/minimax_h3_video_vae_int8_convrot.safetensors"}
  },
  "audio_vae": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "H3/minimax_h3_audio_vae_fp32.safetensors"}
  },
  "video_decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["load", 0], "vae": ["video_vae", 0]}
  },
  "audio_decode": {
    "class_type": "VAEDecodeAudio",
    "inputs": {"samples": ["load", 0], "vae": ["audio_vae", 0]}
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["video_decode", 0], "audio": ["audio_decode", 0], "fps": 24}
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {"video": ["create_video", 0], "filename_prefix": "h3_pipeline/REPLACE_RUN_ID", "format": "video/h264-mp4", "codec": "h264"}
  }
}
